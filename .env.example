# Ring — generate at https://developer.amazon.com/ring/console/playground
# Lasts 30 minutes. You can also paste it straight into the interface.
RING_TOKEN=

# Run against the built-in emulator instead of the live API
THRESHOLD_OFFLINE=0

# AWS Bedrock, for real descriptions. Without these, Threshold falls back to
# canned descriptions and says so in the interface.
#
# Easiest: a Bedrock API key, made in one click in the Bedrock console. This
# is AWS's own variable name, so a key pasted here needs no renaming.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Or an IAM access key pair instead, signed with SigV4. Used only when there
# is no API key above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Or neither: a vision model on this machine through Ollama, which costs
# nothing and sends no picture anywhere. Name a tag `ollama list` shows that
# reports the "vision" capability. Tried after Bedrock, before the canned
# fallback.
THRESHOLD_OLLAMA_MODEL=
THRESHOLD_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Phone push, no account needed: pick a hard-to-guess topic and subscribe to it
# in the ntfy app.
THRESHOLD_NTFY_TOPIC=

THRESHOLD_PORT=8765
THRESHOLD_DB=threshold.db
